# ==========================================
# CONFIGURACIÓN DEMO - CLUB POLACO CRM
# ==========================================
# Con DEMO_MODE=true el sistema funciona al 100% de forma autónoma
# sin requerir credenciales reales para su demostración y despliegue en Vercel.
DEMO_MODE=true
NEXT_PUBLIC_APP_URL=https://club-polaco-demo.vercel.app

# Supabase (Opcional en modo Demo)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# WhatsApp Business API (Opcional en modo Demo)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Pasarela de Pagos (BNB Simple QR / CyberSource - Opcional en modo Demo)
PAYMENT_PROVIDER_KEY=
PAYMENT_WEBHOOK_SECRET=

# Sistema Contable / ERP (Opcional en modo Demo)
ACCOUNTING_API_URL=
ACCOUNTING_API_KEY=
